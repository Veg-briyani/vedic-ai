                "logic_block": {
                    "operator": "AND",
                    "clauses": [
                        {
                            "type": "house_state",
                            "house": 1,
                            "sign_type": "Malefic"
                        },
                        {
                            "type": "planet_state",
                            "planet": {
                                "selector": "lord_of_house",
                                "house": 1
                            },
                            "house": 7
                        },
                        {
                            "type": "planet_state",
                            "planet": "Jupiter",
                            "house": 8
                        },
                        {
                            "type": "planet_conjunction",
                            "planets": [
                                "Jupiter",
                                "Sun"
                            ],
                            "house": 8
                        }
                    ]
                }
            },
            "effects": [
                {
                    "category": "longevity",
                    "description": "The child will die at the age of eight.",
                    "impact": "Negative",
                    "intensity": "High",
                    "probability": "Certain",
                    "context": "Triggers at age 8"
