{
    "rules": [
        {
            "id": "garga_hora_rule_001",
            "original_text": "Jupiter in his own house along with Saturn and Mercury will bestow long life. Such native often will beget wealth.",
            "conditions": {
                "logic_block": {
                    "operator": "AND",
                    "clauses": [
                        {
                            "type": "planet_state",
                            "planet": "Jupiter",
                            "relation_to_sign": "Own_House"
                        },
                        {
                            "type": "planet_conjunction",
                            "planets": [
                                "Jupiter",
                                "Saturn",
                                "Mercury"
                            ]
                        }
                    ]
                }
            },
            "effects": [
                {
                    "category": "longevity",
                    "description": "The native will have a long life.",
                    "impact": "Positive",
                    "intensity": "High",
                    "probability": "Likely"
                },
                {
                    "category": "wealth",
                    "description": "The native will often beget wealth.",
                    "impact": "Positive",
                    "intensity": "Medium",
                    "probability": "Likely"
                }
            ],
            "tags": [
                "Jupiter",
                "Saturn",
                "Mercury",
                "own_house",
                "conjunction",
                "longevity",
                "wealth"
            ],
            "metadata": {
