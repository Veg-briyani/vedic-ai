            "original_text": "Should Venus be in Pisces along with Jupiter and the Moon, the native will acquire kingly fortunes and will have many sons and family.",
            "conditions": {
                "logic_block": {
                    "operator": "AND",
                    "clauses": [
                        {
                            "type": "planet_state",
                            "planet": "Venus",
                            "sign": "Pisces"
                        },
                        {
                            "type": "planet_conjunction",
                            "planets": [
                                "Venus",
                                "Jupiter",
                                "Moon"
                            ]
                        }
                    ]
                }
            },
            "effects": [
                {
                    "category": "wealth",
                    "description": "The native will acquire kingly fortunes.",
                    "impact": "Positive",
                    "intensity": "High",
                    "probability": "Likely"
                },
                {
                    "category": "family",
                    "description": "The native will have many sons and family.",
                    "impact": "Positive",
                    "intensity": "High",
